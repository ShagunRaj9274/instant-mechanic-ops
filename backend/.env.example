NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# Local: postgresql://postgres:postgres@localhost:5432/instant_mechanic
# Neon:  postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instant_mechanic

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Live ops simulator drives realtime status changes for the demo
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=6000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
